#!/usr/bin/env python3
"""
mobile-managementd — SONiC BLE peripheral daemon entry point.

Launched by systemd as the mobile-management service. Always runs in
headless mode (no TUI). Configuration is read from CONFIG_DB; CLI
arguments serve as fallback defaults.
"""

import asyncio
import logging
import sys

from mobile_management.peripheral import main, _parse_users, BLE_NAME_MAX
from mobile_management.backend import create_backend

log = logging.getLogger("mobile-managementd")


def _read_config_db():
    """Read mobile-management config from CONFIG_DB, return a dict of settings."""
    defaults = {
        'device_name': 'SwitchMon',
        'interval': 2.0,
        'num_ports': 48,
        'session_duration': 0.0,
        'backend': 'auto',
        'users': {},
    }
    try:
        from swsscommon.swsscommon import ConfigDBConnector
        db = ConfigDBConnector()
        db.connect()

        entry = db.get_entry('MOBILE_MANAGEMENT', 'GLOBAL') or {}
        if entry:
            defaults['device_name'] = entry.get('device_name', defaults['device_name'])
            defaults['interval'] = float(entry.get('interval', defaults['interval']))
            defaults['num_ports'] = int(entry.get('num_ports', defaults['num_ports']))
            defaults['session_duration'] = float(entry.get('session_duration', defaults['session_duration']))
            defaults['backend'] = entry.get('backend', defaults['backend'])

        auth_table = db.get_table('MOBILE_MANAGEMENT_AUTH') or {}
        for username, data in auth_table.items():
            password = data.get('password', '')
            if password:
                defaults['users'][username] = password

    except ImportError:
        log.info("swsscommon not available — using CLI args / defaults")
    except Exception as exc:
        log.warning(f"CONFIG_DB read failed: {exc} — using CLI args / defaults")

    return defaults


def _cli():
    import argparse
    parser = argparse.ArgumentParser(
        description="SONiC mobile-management BLE peripheral daemon")
    parser.add_argument("--ports",    type=int,   default=None)
    parser.add_argument("--interval", type=float, default=None)
    parser.add_argument("--duration", type=float, default=None)
    parser.add_argument("--users",    type=str,   default="",
                        help="Comma-separated user:pass pairs")
    parser.add_argument("--name",     type=str,   default=None,
                        help=f"BLE device name (max {BLE_NAME_MAX} chars)")
    parser.add_argument("--backend",  type=str,   default=None,
                        choices=["sim", "sonic", "auto"],
                        help="Sensor data backend")
    return parser.parse_args()


def main_entry():
    cfg = _read_config_db()
    args = _cli()

    num_ports = args.ports or cfg['num_ports']
    interval = args.interval if args.interval is not None else cfg['interval']
    duration = args.duration if args.duration is not None else cfg['session_duration']
    name = args.name or cfg['device_name']
    backend_kind = args.backend or cfg['backend']

    users = cfg['users']
    if args.users:
        users.update(_parse_users(args.users))

    try:
        asyncio.run(main(
            num_ports, interval, duration,
            users, name, headless=True,
        ))
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main_entry()
